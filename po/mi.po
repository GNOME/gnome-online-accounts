msgstr "Hapa i te poroporo i te hua i whiwhi mai i te mōwhiti kī: "

#. Translators: The %s is the type of the provider, e.g. 'google' or 'yahoo'
#: src/goabackend/goautils.c:305
#, c-format
msgid "GOA %s credentials for identity %s"
msgstr "Ngā tohu takiuru GOA %s mō te tuakiri %s"

#. TODO: more specific
#: src/goabackend/goautils.c:322
msgid "Failed to store credentials in the keyring"
msgstr "I rahua te penapena i ngā tohu takiuru ki te mōwhiti kī"

#: src/goabackend/goautils.c:800
msgid "Not found"
msgstr "Kīhai i kitea"

#: src/goabackend/goautils.c:814
#, c-format
msgid "Code: %u — Unexpected response from server"
msgstr "Waehere: %u — He urupare ohorere mai i te tūmau"

#: src/goabackend/goautils.c:839
msgid "The signing certificate authority is not known."
msgstr "Tē mōhiotia te mana tiwhikete waitohu."

#: src/goabackend/goautils.c:843
msgid ""
"The certificate does not match the expected identity of the site that it was "
"retrieved from."
msgstr ""
"Kāore te tiwhikete e hāngai ki te tuakiri e tūmanakohia ana o te pae i "
"tikina mai ai."

#: src/goabackend/goautils.c:848
msgid "The certificate’s activation time is still in the future."
msgstr "Kei te anamata tonu te wā whakahohe o te tiwhikete."

#: src/goabackend/goautils.c:852
msgid "The certificate has expired."
msgstr "Kua pau te wā o te tiwhikete."

#: src/goabackend/goautils.c:856
msgid "The certificate has been revoked."
msgstr "Kua whakakorea te tiwhikete."

#: src/goabackend/goautils.c:860
msgid "The certificate’s algorithm is considered insecure."
msgstr "E kīia ana he haumarukore te hātepe o te tiwhikete."

#: src/goabackend/goautils.c:866
msgid "Invalid certificate."
msgstr "Tiwhikete muhu."

#. TODO: more specific
#: src/goabackend/goautils.c:901
#, c-format
msgid "Did not find %s with identity “%s” in credentials"
msgstr "Kāore i kitea te %s me te tuakiri “%s” i ngā tohu takiuru"

